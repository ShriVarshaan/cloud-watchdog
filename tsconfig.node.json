{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["tests/e2e/**/*", "tests/packaged/**/*"]
}
